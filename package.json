{
  "name": "aviator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A low-poly flying game built with TypeScript and Three.js",
  "author": "Erwin Kok",
  "license": "ISC",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test test/unit/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "20.19.43",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
